// Cloudflare Worker + GameRoom Durable Object + D1 (GDD §10.2). `npm run build` builds the
// SPA and the Worker through @cloudflare/vite-plugin; `npm run deploy` ships both.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaugadi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GameRoom", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chaugadi",
      // Replace with the id from `npx wrangler d1 create chaugadi` before the first deploy.
      "database_id": "91a16eeb-6ff2-42e0-aea3-c4e12f7bd7fb",
      "migrations_dir": "migrations"
    }
  ],
  // TOKEN_SECRET: `npx wrangler secret put TOKEN_SECRET` in production, .dev.vars locally.
  "observability": { "enabled": true }
}
