{
  "name": "chaugadi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.json tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.json tsconfig.server.json",
    "test": "vitest run",
    "visual": "node e2e/visual.mjs",
    "e2e": "npm run build && npm run db:migrate && playwright test",
    "e2e:ui": "playwright test --ui",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply chaugadi --local",
    "cf-typegen": "wrangler types src/server/worker-configuration.d.ts",
    "e2e:server": "npm run db:migrate && node e2e/server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/dm-mono": "^5.1.0",
    "partyserver": "^0.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.23.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
